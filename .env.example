# ---- API (apps/api) ----
NODE_ENV=development
PORT=3000
# PostgreSQL (production) or PGlite for local work without a server: pglite://./.data/pglite | pglite://memory
DATABASE_URL=postgres://sauna:sauna@localhost:5432/sauna
PUBLIC_API_URL=http://localhost:3000
ADMIN_URL=http://localhost:5174
CONFIGURATOR_URL=http://localhost:5173
# smtp://user:pass@host:587 or "memory" (dev outbox at GET /dev/outbox)
SMTP_URL=memory
MAIL_FROM="Konfigurátor <noreply@example.com>"
CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
SESSION_TTL_HOURS=168
MAGIC_LINK_TTL_MINUTES=15
WORKER_INTERVAL_MS=500
# SEED_DEMO=1   # seed the demo tenant also in production

# ---- Configurator build (apps/configurator) ----
# Empty = local demo mode (localStorage); set to the API URL for M4+
VITE_API_BASE=http://localhost:3000
